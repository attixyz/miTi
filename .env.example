# miTi environment variables
#
# Copy this file to `.env.local` and fill in the values you need:
#   cp .env.example .env.local
#
# EVERY variable here is OPTIONAL. With none of them set, the app still works:
#   - dev runs on http://localhost:3000
#   - URLs (canonical, OpenGraph, ICS links) are auto-detected from the request
#     host, so a free *.vercel.app deploy "just works" with zero config
#   - analytics and verbose i18n logging stay off
#
# Note: `.env*.local` is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# Canonical site URL
# ---------------------------------------------------------------------------
# The public origin (scheme + host, no trailing slash) used for canonical links,
# OpenGraph/Twitter URLs, and the metadata base. Set this ONCE you have a stable
# custom domain so SEO canonicals don't drift between *.vercel.app and the real
# domain. Leave it unset to auto-detect the host per request.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Plausible analytics
# ---------------------------------------------------------------------------
# The site key registered in your Plausible dashboard (a domain string, NOT a
# detected host). The analytics <script> is only injected when this is set, so
# localhost and preview deploys send no stats. Leave unset to disable analytics.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com

# ---------------------------------------------------------------------------
# i18next debug logging
# ---------------------------------------------------------------------------
# Set to "true" for verbose i18next logging in the console. Off by default.
# NEXT_PUBLIC_I18N_DEBUG=false

# ---------------------------------------------------------------------------
# Platform-injected (do NOT set these manually)
# ---------------------------------------------------------------------------
# Provided automatically by the runtime / host; listed here for reference only:
#   NODE_ENV                        - "development" | "production" (set by Next.js)
#   PORT                            - dev/start port (defaults to 3000)
#   VERCEL_PROJECT_PRODUCTION_URL   - stable prod domain, injected on Vercel
#   VERCEL_URL                      - per-deploy URL, injected on Vercel
